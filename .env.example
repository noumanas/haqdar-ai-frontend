# Base URL of the Haqdar backend API (server-side only; never sent to the browser)
HAQDAR_API_URL=http://localhost:3000/api/v1

# Same API, called from the browser by the public "Try the demo" page (only /demo endpoints)
NEXT_PUBLIC_HAQDAR_API_URL=http://localhost:3000/api/v1

# Haqdar's WhatsApp number, digits only with country code (e.g. 971501234567).
# Read at build time, so rebuild after changing it. Empty: the buttons scroll to "Get started".
NEXT_PUBLIC_WHATSAPP_NUMBER=
